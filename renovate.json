{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeDigest",
    ":maintainLockFilesWeekly"
  ],
  "pinDigests": true,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
